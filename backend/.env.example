# Copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=sk-...
# Base URL of the deployed Modal service (serves both /synthesize and /transcribe).
MODAL_TTS_URL=https://your-workspace--slicksale-tts-ttsmodel-web.modal.run
# Comma-separated CORS origins (the Flutter web app).
ALLOWED_ORIGINS=http://localhost:8080
